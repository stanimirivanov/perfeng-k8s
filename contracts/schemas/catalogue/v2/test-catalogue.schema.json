{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/catalogue/v2/test-catalogue.schema.json",
  "title": "Versioned performance test catalogue with execution provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "tests"],
  "properties": {
    "apiVersion": {"const": "performance.perfeng.io/v2"},
    "kind": {"const": "TestCatalogue"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/version"
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "owner",
          "criticality",
          "tool",
          "source",
          "artifact",
          "workloads"
        ],
        "properties": {
          "id": {
            "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/id"
          },
          "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "owner": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "criticality": {"enum": ["low", "medium", "high", "critical"]},
          "description": {"type": "string"},
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"enum": ["k6", "playwright"]},
              "version": {
                "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/version"
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "gitSha", "entrypoint"],
            "properties": {
              "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
              "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "entrypoint": {
                "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/relativePath"
              }
            }
          },
          "artifact": {"$ref": "#/$defs/executionArtifact"},
          "workloads": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json"}
          },
          "schedule": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "pr": {"$ref": "#/$defs/profile"},
              "main": {"$ref": "#/$defs/profile"},
              "nightly": {"$ref": "#/$defs/profile"},
              "scheduled": {"$ref": "#/$defs/profile"},
              "release": {"$ref": "#/$defs/profile"}
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://perfeng.dev/schemas/result/v1/test-result.schema.json#/properties/metric"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "profile": {"enum": ["smoke", "average", "regression", "stress", "capacity", "soak"]},
    "executionArtifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "image"],
          "properties": {
            "kind": {"const": "oci-image"},
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "gitSha", "dependencyLock"],
          "properties": {
            "kind": {"const": "source-checkout"},
            "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
            "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "dependencyLock": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {
                  "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/relativePath"
                },
                "sha256": {
                  "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/sha256"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "archiveSha256", "executableSha256"],
          "properties": {
            "kind": {"const": "release-archive"},
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^\\s@?#]+$"
            },
            "archiveSha256": {
              "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/sha256"
            },
            "executableSha256": {
              "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/sha256"
            }
          }
        }
      ]
    }
  }
}
