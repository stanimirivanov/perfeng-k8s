{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/workload/v1/workload.schema.json",
  "title": "Versioned workload definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "tool",
    "profile",
    "model",
    "configuration",
    "phases",
    "dataset"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "tool": {
      "enum": [
        "k6",
        "playwright",
        "kube-burner"
      ]
    },
    "profile": {
      "enum": [
        "smoke",
        "average",
        "regression",
        "stress",
        "capacity",
        "soak"
      ]
    },
    "model": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "warmup",
        "measurement",
        "cooldown"
      ],
      "properties": {
        "unit": {
          "enum": [
            "seconds",
            "iterations"
          ]
        },
        "warmup": {
          "type": "integer",
          "minimum": 0
        },
        "measurement": {
          "type": "integer",
          "minimum": 1
        },
        "cooldown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dataset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "version",
            "sha256",
            "seed"
          ],
          "properties": {
            "kind": {
              "const": "versioned"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "version": {
              "$ref": "#/$defs/version"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "const": "k6"
          }
        }
      },
      "then": {
        "properties": {
          "phases": {
            "properties": {
              "unit": {
                "const": "seconds"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "playwright"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "const": "closed"
          },
          "phases": {
            "properties": {
              "unit": {
                "const": "iterations"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "kube-burner"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "const": "open"
          },
          "phases": {
            "properties": {
              "unit": {
                "const": "iterations"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_./-]+$"
    }
  }
}
